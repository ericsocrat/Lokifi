{
  // ============================================
  // LOKIFI WORKSPACE SETTINGS - FULLY OPTIMIZED
  // Optimized for: Next.js 15 + FastAPI + Vitest + Pytest
  // Last Updated: January 9, 2026
  // Optimization Level: HIGH PERFORMANCE (32GB RAM) ⭐⭐
  // ============================================

  // ===== PERFORMANCE - AGGRESSIVE OPTIMIZATIONS (32GB RAM + RTX 3070 Ti) =====
  // Gives Copilot & heavy extensions their own process (MAJOR lag reduction)
  "extensions.experimental.affinity": {
    "GitHub.copilot": 1,
    "GitHub.copilot-chat": 1,
    "ms-python.python": 2,
    "ms-python.vscode-pylance": 2,
    "dbaeumer.vscode-eslint": 3
  },
  // Increase Node.js memory for extension host (default ~1.5GB → 8GB for 32GB system)
  "extensions.experimental.extensionHostMaxHeapSizeInMb": 8192,
  // Reduce Git overhead
  "git.autorefresh": false,
  "git.decorations.enabled": true,
  "git.enableStatusBarSync": false,
  // Disable expensive features
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  // Reduce file watcher overhead
  "files.watcherExcludeWorkspaceFolder": true,
  // Disable telemetry (reduces background network/processing)
  "telemetry.telemetryLevel": "off",
  // Chat-specific optimizations (prevents lag with long conversations)
  "chat.editor.wordWrap": "off",
  // Workbench performance
  "workbench.list.smoothScrolling": false,
  "workbench.reduceMotion": "on",
  "window.titleBarStyle": "custom",
  // GPU Acceleration (RTX 3070 Ti) - offload rendering from CPU
  "gpu_acceleration": "on",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.fastScrollSensitivity": 10,

  // ===== EDITOR - PERFORMANCE & UX =====
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.addMissingImports": "explicit"
  },
  "editor.rulers": [80, 120],
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.inlineSuggest.enabled": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.snippetSuggestions": "top",
  "editor.wordWrap": "off",
  "editor.minimap.enabled": false,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.maxColumn": 120,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.smoothScrolling": false,
  "editor.mouseWheelZoom": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.quickSuggestionsDelay": 0,
  "editor.parameterHints.enabled": true,
  "editor.renderWhitespace": "selection",
  "editor.occurrencesHighlight": "singleFile",
  "editor.selectionHighlight": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.maxTokenizationLineLength": 20000,
  "editor.formatOnPaste": true,
  "editor.formatOnType": false,
  "editor.autoClosingBrackets": "languageDefined",
  "editor.autoClosingQuotes": "languageDefined",
  "editor.autoClosingDelete": "auto",
  "editor.autoClosingOvertype": "auto",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.suggest.preview": true,
  "editor.suggest.showDetails": true,
  "editor.suggest.showStatusBar": true,
  "editor.suggest.insertMode": "insert",
  "editor.suggest.filterGraceful": true,
  "editor.suggest.localityBonus": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.inlayHints.enabled": "on",
  "editor.largeFileOptimizations": true,

  // ===== FILES - AUTO-SAVE & EXCLUSIONS =====
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "files.hotExit": "onExitAndWindowClose",
  "files.defaultLanguage": "typescript",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/__pycache__/**": true,
    "**/coverage/**": true,
    "**/.lokifi-cache/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/venv/**": true,
    "**/.venv/**": true,
    "**/site-packages/**": true,
    "**/.pytest_cache/**": true,
    "**/htmlcov/**": true,
    "**/*.log": true,
    "**/logs/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/node_modules": true,
    "**/.pytest_cache": true,
    "**/.coverage": true,
    "**/coverage": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },

  // ===== SEARCH - SMART EXCLUSIONS =====
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/__pycache__": true,
    "**/coverage": true,
    "**/.pytest_cache": true,
    "**/dist": true,
    "**/.lokifi-cache": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/*.log": true,
    "**/.venv": true,
    "**/venv": true
  },
  "search.useIgnoreFiles": true,
  "search.smartCase": true,
  "search.followSymlinks": false,
  "search.maxResults": 20000,
  "search.quickOpen.includeSymbols": true,
  "search.quickOpen.includeHistory": true,

  // ===== TYPESCRIPT / JAVASCRIPT - FORMATTING =====
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.quickSuggestions": {
      "strings": true
    }
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifier": "relative",
  // TypeScript hoisted to root node_modules due to npm workspaces
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "javascript.suggest.autoImports": true,
  "typescript.suggest.autoImports": true,
  "typescript.suggest.paths": true,
  "typescript.tsserver.maxTsServerMemory": 12288,
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriorityPolling"
  },
  "typescript.suggest.completeFunctionCalls": true,
  "javascript.suggest.completeFunctionCalls": true,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.log": "off",
  "typescript.surveys.enabled": false,
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.parameterTypes.enabled": false,
  "typescript.inlayHints.variableTypes.enabled": false,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": false,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": false,
  "typescript.inlayHints.enumMemberValues.enabled": false,
  "javascript.inlayHints.parameterNames.enabled": "literals",
  "javascript.inlayHints.parameterTypes.enabled": false,
  "javascript.inlayHints.variableTypes.enabled": false,
  "javascript.inlayHints.propertyDeclarationTypes.enabled": false,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": false,
  "javascript.inlayHints.enumMemberValues.enabled": false,

  // ===== PYTHON - BACKEND CONFIGURATION =====
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.tabSize": 4,
    "editor.rulers": [100]
  },
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": false,
  "python.analysis.inlayHints.pytestParameters": true,
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.memory.keepLibraryAst": false,
  "python.analysis.persistAllIndices": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/backend/venv/Scripts/python.exe",
  "python.envFile": "${workspaceFolder}/apps/backend/.env",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.pytestArgs": [
    "apps/backend/tests"
  ],
  "python.languageServer": "Pylance",
  "python.analysis.indexing": false,
  "python.analysis.exclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/coverage/**",
    "**/htmlcov/**",
    "**/venv/**",
    "**/.venv/**",
    "**/site-packages/**",
    "**/apps/frontend/**",
    "**/apps/admin/**",
    "**/apps/mobile/**",
    "**/infra/**",
    "**/tools/**"
  ],
  "isort.args": ["--profile", "black"],
  "black-formatter.args": ["--line-length", "100"],

  // ===== POWERSHELL - SCRIPT CONFIGURATION =====
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [120]
  },
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.codeFormatting.preset": "OTBS",
  "powershell.codeFormatting.autoCorrectAliases": true,
  "powershell.codeFormatting.useConstantStrings": true,
  "powershell.codeFormatting.useCorrectCasing": true,
  "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
  "powershell.codeFormatting.addWhitespaceAroundPipe": true,

  // ===== VITEST =====
  "vitest.enable": true,
  "vitest.workspaceFolder": "${workspaceFolder}/apps/frontend",
  "vitest.commandLine": "npx vitest",
  "vitest.include": ["**/*.{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"],
  "vitest.exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/cypress/**",
    "**/.{idea,git,cache,output,temp}/**"
  ],
  "vitest.showFailMessages": true,
  "vitest.watchOnStartup": "openTesting",

  // ===== PLAYWRIGHT =====
  "playwright.reuseBrowser": false,
  "playwright.showTrace": true,

  // ===== COVERAGE GUTTERS =====
  "coverage-gutters.coverageFileNames": [
    "apps/frontend/coverage/lcov.info",
    "apps/frontend/coverage/coverage-final.json",
    "apps/backend/htmlcov/coverage.json"
  ],
  "coverage-gutters.showLineCoverage": true,
  "coverage-gutters.showRulerCoverage": true,
  "coverage-gutters.highlightdark": "rgba(16, 185, 129, 0.15)",
  "coverage-gutters.highlightlight": "rgba(16, 185, 129, 0.15)",

  // ===== CONSOLE NINJA =====
  "console-ninja.featureSet": "Community",
  "console-ninja.toolsToEnableSupportAutomaticallyFor": {
    "live-server-extension": true,
    "live-preview-extension": true
  },

  // ===== IMPORT COST =====
  "importCost.bundleSizeDecoration": "both",
  "importCost.showCalculatingDecoration": true,
  "importCost.smallPackageSize": 50,
  "importCost.mediumPackageSize": 100,
  "importCost.largePackageColor": "#ff6b6b",
  "importCost.mediumPackageColor": "#feca57",
  "importCost.smallPackageColor": "#48dbfb",

  // ===== ESLINT - LINTING =====
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [
    { "directory": "./apps/frontend", "changeProcessCWD": true }
  ],
  "eslint.format.enable": false,
  "eslint.codeActionsOnSave.mode": "all",

  // ===== PRETTIER =====
  "prettier.enable": true,
  "prettier.requireConfig": true,

  // ===== ERROR LENS - INLINE ERRORS =====
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning"
  ],
  "errorLens.excludeBySource": [
    "cSpell"
  ],
  "errorLens.fontWeight": "normal",
  "errorLens.fontSize": "0.9em",
  "errorLens.delay": 500,
  "errorLens.followCursor": "activeLine",

  // ===== TAILWIND CSS =====
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },

  // ===== GIT & GITLENS - VERSION CONTROL =====
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.postCommitCommand": "push",
  "git.autofetchPeriod": 180,
  "git.pruneOnFetch": true,
  "git.untrackedChanges": "separate",
  "git.ignoreRebaseWarning": true,
  "git.maxFileSize": 5242880,
  "git.allowForcePush": false,
  "git.branchProtection": ["main", "master", "production"],
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.hovers.enabled": false,
  "gitlens.statusBar.enabled": true,
  "gitlens.blame.avatars": false,
  "gitlens.blame.format": "${message|40?} ${agoOrDate|14-}",
  "gitlens.blame.highlight.enabled": false,
  "gitlens.changes.locations": ["line"],
  "gitlens.heatmap.toggleMode": "file",
  "gitlens.views.repositories.avatars": false,
  "gitlens.views.fileHistory.avatars": false,
  "gitlens.views.lineHistory.avatars": false,
  "gitlens.views.commits.avatars": false,
  "gitlens.views.contributors.avatars": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,

  // ===== DOCKER =====
  "docker.showExplorer": true,

  // ===== TODO TREE - ENHANCED TASK TRACKING =====
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "BUG",
    "HACK",
    "NOTE",
    "XXX",
    "TASK",
    "TEST",
    "COVERAGE",
    "REFACTOR",
    "OPTIMIZE",
    "CRITICAL",
    "HIGH",
    "MEDIUM",
    "LOW",
    "DONE",
    "[ ]",
    "[x]"
  ],
  "todo-tree.general.statusBar": "total",
  "todo-tree.general.revealBehaviour": "start of todo",
  "todo-tree.general.tagGroups": {
    "CRITICAL": ["CRITICAL", "FIXME", "BUG"],
    "TASKS": ["TODO", "TASK", "HACK"],
    "TESTING": ["TEST", "COVERAGE"],
    "QUALITY": ["OPTIMIZE", "REFACTOR"],
    "INFO": ["NOTE", "XXX"]
  },
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\*))\\s*($TAGS)",
  "todo-tree.highlights.enabled": true,
  "todo-tree.highlights.defaultHighlight": {
    "icon": "alert",
    "type": "text-and-comment",
    "foreground": "#ffffff",
    "background": "#feca57",
    "opacity": 50,
    "iconColour": "#feca57",
    "gutterIcon": true
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#48dbfb",
      "iconColour": "#48dbfb"
    },
    "TASK": {
      "icon": "tasklist",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#00aa00",
      "iconColour": "#00aa00"
    },
    "FIXME": {
      "icon": "flame",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#ff6b6b",
      "iconColour": "#ff6b6b"
    },
    "BUG": {
      "icon": "bug",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#ff6b6b",
      "iconColour": "#ff6b6b"
    },
    "CRITICAL": {
      "icon": "alert",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#ff0000",
      "iconColour": "#ff0000"
    },
    "TEST": {
      "icon": "beaker",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#00ced1",
      "iconColour": "#00ced1"
    },
    "COVERAGE": {
      "icon": "graph",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#32cd32",
      "iconColour": "#32cd32"
    },
    "REFACTOR": {
      "icon": "sync",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#4169e1",
      "iconColour": "#4169e1"
    },
    "OPTIMIZE": {
      "icon": "zap",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#9370db",
      "iconColour": "#9370db"
    },
    "NOTE": {
      "icon": "note",
      "type": "text-and-comment",
      "foreground": "#000",
      "background": "#ffff00",
      "iconColour": "#ffff00"
    },
    "HACK": {
      "icon": "tools",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#ff8c00",
      "iconColour": "#ff8c00"
    },
    "DONE": {
      "icon": "check-circle",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#00aa00",
      "iconColour": "#00aa00"
    },
    "HIGH": {
      "icon": "arrow-up",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#ff6347",
      "iconColour": "#ff6347"
    },
    "MEDIUM": {
      "icon": "dash",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#ffa500",
      "iconColour": "#ffa500"
    },
    "LOW": {
      "icon": "arrow-down",
      "type": "text-and-comment",
      "foreground": "#fff",
      "background": "#90ee90",
      "iconColour": "#90ee90"
    }
  },
  "todo-tree.filtering.excludeGlobs": [
    "**/node_modules/**",
    "**/.next/**",
    "**/coverage/**",
    "**/.pytest_cache/**",
    "**/dist/**",
    "**/build/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/.git/**",
    "**/htmlcov/**",
    "**/.lokifi-cache/**"
  ],
  "todo-tree.filtering.includeGlobs": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.py",
    "**/*.md",
    "**/*.json",
    "**/*.yaml",
    "**/*.yml"
  ],
  "todo-tree.tree.showCountsInTree": true,
  "todo-tree.tree.showBadges": true,
  "todo-tree.tree.grouped": true,
  "todo-tree.tree.expanded": true,
  "todo-tree.tree.flat": false,
  "todo-tree.tree.sort": true,
  "todo-tree.tree.tagsOnly": false,
  "todo-tree.tree.hideIconsWhenGroupedByTag": false,

  // ===== TERMINAL =====
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.persistentSessionReviveProcess": "onExit",
  "terminal.integrated.enablePersistentSessions": true,

  // ===== PERFORMANCE - OPTIMIZATIONS =====
  "files.maxMemoryForLargeFilesMB": 4096,
  "files.simpleDialog.enable": true,
  "extensions.ignoreRecommendations": true,
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "extensions.experimental.useAutoProfilingMode": true,
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.reduceMotion": "off",
  "window.restoreWindows": "none",
  "window.newWindowDimensions": "inherit",
  "telemetry.telemetryLevel": "off",
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  "git.decorations.enabled": true,
  "git.timeline.showUncommitted": false,
  "scm.diffDecorations": "gutter",
  "scm.diffDecorationsGutterWidth": 3,
  "editor.codeLens": true,
  "diffEditor.codeLens": false,

  // ===== GITHUB COPILOT - AI ASSISTANCE (OPTIMIZED) =====
  // Enable Copilot for all relevant file types
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },

  // Editor completions and suggestions
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.editor.enableCodeActions": true,

  // Chat settings - Enhanced for better context
  "github.copilot.chat.useProjectTemplates": true,
  "github.copilot.chat.scopeSelection": true,
  "github.copilot.chat.runCommand.enabled": true,
  "github.copilot.chat.terminalChatLocation": "quickChat",
  "github.copilot.chat.followUps": "on",
  "github.copilot.chat.localeOverride": "en",

  // Enable search capabilities (requires GitHub Copilot with search enabled)
  "github.copilot.chat.search.enabled": true,

  // Advanced settings for better code generation (optimized for comprehensive responses)
  "github.copilot.advanced": {
    "length": 5000,
    "temperature": "",
    "top_p": 1,
    "stops": {
      "*": ["\n\n\n"],
      "python": ["\ndef ", "\nclass ", "\nif ", "\n\n#"],
      "javascript": ["\nfunction ", "\nclass ", "\nif ", "\n\n//"],
      "typescript": ["\nfunction ", "\nclass ", "\nif ", "\ninterface ", "\ntype ", "\n\n//"],
      "typescriptreact": ["\nfunction ", "\nclass ", "\nif ", "\ninterface ", "\ntype ", "\nconst ", "\n\n//"],
      "javascriptreact": ["\nfunction ", "\nclass ", "\nif ", "\nconst ", "\n\n//"]
    },
    "inlineSuggestCount": 3
  },

  // Inline suggestions
  "github.copilot.inlineSuggest.enable": true,

  // Completions preference
  "github.copilot.editor.iterativeFixing": true,

  // ===== WORKBENCH - UI PREFERENCES =====
  "workbench.colorTheme": "Default Dark+",
  "workbench.iconTheme": "vs-seti",

  // Color customizations for visual distinction
  "workbench.colorCustomizations": {
    // Development environment (blue theme)
    "titleBar.activeBackground": "#1e3a8a",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#1e40af",
    "titleBar.inactiveForeground": "#94a3b8",
    "statusBar.background": "#1e3a8a",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderBackground": "#334155",
    "statusBar.debuggingBackground": "#dc2626",
    "statusBar.debuggingForeground": "#ffffff",
    "activityBar.activeBackground": "#1e40af33",
    "activityBar.activeBorder": "#3b82f6"
  },

  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.closeEmptyGroups": false,
  "workbench.editor.revealIfOpen": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 10,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.tree.indent": 20,
  "workbench.list.smoothScrolling": true,
  "workbench.activityBar.location": "default",
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.decorations.badges": true,
  "workbench.editor.decorations.colors": true,
  "workbench.editor.tabCloseButton": "right",
  "workbench.editor.tabSizing": "shrink",
  "workbench.commandPalette.history": 50,
  "problems.autoReveal": false,
  "problems.showCurrentInStatus": true,

  // ===== FILE EXPLORER - FILE NESTING =====
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.map",
    "*.tsx": "${capture}.test.tsx, ${capture}.module.css, ${capture}.stories.tsx",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.test.jsx",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc, .yarnrc",
    ".env": ".env.*, .envrc",
    "tsconfig.json": "tsconfig.*.json",
    "vite.config.*": "vitest.config.*",
    "tailwind.config.*": "postcss.config.*",
    "README.md": "README.*, LICENSE, CHANGELOG.md"
  },

  // ===== NPM - PACKAGE MANAGEMENT =====
  "npm.packageManager": "npm",
  "npm.fetchOnlinePackageInfo": false,
  "npm.autoDetect": "on",
  "npm.runSilent": false,

  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",
  "breadcrumbs.symbolSortOrder": "position",
  "breadcrumbs.showKeys": false,
  "breadcrumbs.showFunctions": true,
  "breadcrumbs.showClasses": true,

  // ===== SECURITY =====
  "security.workspace.trust.untrustedFiles": "prompt",

  // ===== EMMET - HTML/CSS SHORTCUTS =====
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  "emmet.triggerExpansionOnTab": true,

  // ===== PATH INTELLISENSE =====
  "path-intellisense.autoSlashAfterDirectory": true,
  "path-intellisense.extensionOnImport": true,
  "path-intellisense.mappings": {
    "@": "${workspaceFolder}/apps/frontend",
    "@/components": "${workspaceFolder}/apps/frontend/components",
    "@/lib": "${workspaceFolder}/apps/frontend/lib",
    "@/hooks": "${workspaceFolder}/apps/frontend/hooks",
    "@/app": "${workspaceFolder}/apps/frontend/app"
  },

  // ===== NPM INTELLISENSE =====
  "npm-intellisense.importES6": true,
  "npm-intellisense.importQuotes": "'",
  "npm-intellisense.importLinebreak": ";",
  "npm-intellisense.importDeclarationType": "const",
  "npm-intellisense.scanDevDependencies": true,
  "npm-intellisense.showBuildInLibs": true,

  // ===== MARKDOWN =====
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },

  // ===== YAML =====
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced"
  },

  // ===== SQL =====
  "[sql]": {
    "editor.defaultFormatter": "mtxr.sqltools",
    "editor.tabSize": 2
  },

  // ===== VERSION LENS =====
  "versionlens.suggestions.showOnStartup": false,
  "versionlens.npm.caching.duration": 3600,
  "versionlens.pip.caching.duration": 3600,
  "versionlens.suggestions.showPrerelease": false,
  "workbench.editor.tabActionLocation": "right",

  // ===== AUTO RENAME TAG =====
  "auto-rename-tag.activationOnLanguage": [
    "html",
    "xml",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // ===== AUTO IMPORT =====
  "autoimport.filesToScan": "**/*.{ts,tsx,js,jsx}",
  "autoimport.showNotifications": false,
  "autoimport.doubleQuotes": false,
  "autoimport.spaceBetweenBraces": true,
  "autoimport.autoComplete": true,

  // ===== PRETTY TS ERRORS =====
  "prettyTsErrors.showLineNumbers": true,
  "prettyTsErrors.showLinksInError": true,

  // ===== GIT GRAPH =====
  "git-graph.repository.fetchAndPrune": true,
  "git-graph.repository.fetchAndPruneTags": true,
  "git-graph.date.format": "Relative",
  "git-graph.commitDetailsView.autoCenter": true,

  // ===== REST CLIENT =====
  "rest-client.enableTelemetry": false,
  "rest-client.previewResponseInUntitledDocument": false,
  "rest-client.environmentVariables": {
    "$shared": {},
    "development": {
      "baseUrl": "http://localhost:8000",
      "apiUrl": "http://localhost:8000/api/v1"
    },
    "production": {
      "baseUrl": "https://api.www.lokifi.com",
      "apiUrl": "https://api.www.lokifi.com/api/v1"
    }
  },

  // Use .github/copilot-instructions.md for project-specific instructions
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  // ===== CSPELL CONFIGURATION =====
  // Custom dictionary maintained in /cspell.json (single source of truth)
  // VS Code automatically uses root cspell.json - no duplication needed

  // ===== YAML VALIDATION =====
  // Suppress false positive warnings for GitHub Actions workflows
  // Context: VS Code YAML extension doesn't understand ${{ }} expressions
  // These expressions are VALID per GitHub Actions documentation
  // Solution: Disable GitHub Workflow schema validation (prevents false positives)
  "yaml.validate": true,
  "yaml.schemas": {
    // Explicitly set to false to disable schema validation for GitHub Actions
    "https://json.schemastore.org/github-workflow.json": []
  },

  // ===== GITHUB COPILOT - MCP SERVERS =====
  // Model Context Protocol servers for enhanced AI context
  // Enable MCP server discovery from .vscode/mcp.json
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true,
    "windsurf": true,
    "cursor-global": true,
    "cursor-workspace": true
  },
  "github.copilot.chat.mcpServers": {
    "lokifi-coverage": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/mcp-coverage-server.js"]
    },
    "lokifi-codebase": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/mcp-codebase-server.js"]
    },
    "lokifi-security": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/mcp-security-server.js"]
    },
    "lokifi-patterns": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/mcp-pattern-library-server.js"]
    },
    "lokifi-docs": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/mcp-docs-search-server.js"]
    },
    "lokifi-git": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/mcp-git-history-server.js"]
    }
  }
}
