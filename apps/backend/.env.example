# Lokifi Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# REQUIRED SECURITY SETTINGS
# ==========================================
# JWT Secret - Use a strong random string for production
LOKIFI_JWT_SECRET=your-super-secure-jwt-secret-here-change-this

# Alternative JWT Secret Key (for backward compatibility)
JWT_SECRET_KEY=your-super-secure-jwt-secret-here-change-this

# Application Secret Key
SECRET_KEY=your-super-secure-app-secret-key-here-change-this

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///./data/lokifi.sqlite
DATABASE_REPLICA_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ==========================================
# JWT CONFIGURATION
# ==========================================
LOKIFI_JWT_TTL_MIN=1440
JWT_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# ==========================================
# APPLICATION SETTINGS
# ==========================================
PROJECT_NAME=Lokifi
API_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=INFO

# ==========================================
# MARKET DATA PROVIDERS
# ==========================================
FMP_API_KEY=your-fmp-api-key-here
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here
POLYGON_API_KEY=your-polygon-api-key-here

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ==========================================
# CACHE CONFIGURATION
# ==========================================
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# ==========================================
# MONITORING & OBSERVABILITY
# ==========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@lokifi.com
SMTP_FROM_NAME=Lokifi

# ==========================================
# WEBSOCKET CONFIGURATION
# ==========================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================
# Set to false in production
ALLOW_CORS_ALL_ORIGINS=false
RELOAD_ON_CHANGE=true

# ==========================================
# TESTING CONFIGURATION
# ==========================================
TESTING=false
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_ANALYTICS=true
ENABLE_SOCIAL_FEATURES=true
ENABLE_NOTIFICATIONS=true
ENABLE_AI_CHAT=true

# ==========================================
# ADMIN CONFIGURATION
# ==========================================
ADMIN_EMAIL=admin@lokifi.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

# ==========================================
# AI/ML CONFIGURATION
# ==========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==========================================
# STORAGE CONFIGURATION
# ==========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=["image/jpeg","image/png","image/gif","application/pdf"]
