{
  "name": "lokifi-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "postinstall": "echo Skipping rollup rebuild on Windows",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "lint:security": "eslint . --config eslint-security.config.mjs",
    "lint:a11y": "eslint . --config eslint-a11y.config.mjs",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true npm run build",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:ci": "vitest run",
    "test:dashboard": "vitest run coverage-dashboard",
    "test:e2e": "playwright test",
    "test:contracts": "vitest run tests/api/contracts",
    "test:security": "vitest run tests/security",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:visual:ui": "playwright test tests/visual --ui",
    "test:a11y": "playwright test tests/a11y",
    "test:performance": "playwright test tests/performance",
    "test:performance:lhci": "lhci autorun",
    "test:all": "npm run typecheck && npm run test:ci && npm run test:e2e",
    "test:coverage": "vitest run --coverage && node scripts/update-coverage-dashboard.js",
    "clean": "rimraf .next node_modules",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/dom": "^10.4.0",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.19.3",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.5",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "immer": "^11.0.0",
    "jotai": "^2.16.1",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.562.0",
    "lz-string": "^1.5.0",
    "nanoid": "^5.1.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.8",
    "web-vitals": "^5.1.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.28",
    "zod": "^4.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "@axe-core/playwright": "^4.11.0",
    "@axe-core/react": "^4.11.0",
    "@lhci/cli": "^0.15.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@next/bundle-analyzer": "^16.1.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.7",
    "postcss": "^8.5.1",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "next lint --fix --file",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
