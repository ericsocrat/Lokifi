# CI/CD Dockerfile for monorepo context
# Build context should be repository root
FROM node:24-alpine AS deps
WORKDIR /app
# Copy package files from monorepo structure
COPY apps/frontend/package.json ./
COPY package-lock.json ./
RUN apk add --no-cache python3 make g++ git
# Use npm install instead of npm ci to handle monorepo dependencies
RUN npm install --legacy-peer-deps
RUN npm cache clean --force

FROM node:24-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
# Copy frontend source from monorepo path
COPY apps/frontend/ ./
# Set environment variables for build
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV DOCKER_BUILD=true
RUN npm run build

FROM node:24-alpine AS prod
WORKDIR /app

# Next.js 16+ with monorepo outputFileTracingRoot creates nested structure:
# .next/standalone/apps/frontend/server.js (not .next/standalone/server.js)
# Copy the nested structure correctly
COPY --from=build /app/.next/standalone/apps/frontend ./
COPY --from=build /app/.next/standalone/node_modules ./node_modules
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

EXPOSE 3000
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
RUN chown -R nextjs:nodejs /app

USER nextjs

CMD ["node", "server.js"]
