# CI/CD Dockerfile for monorepo context
# Build context should be repository root
FROM node:22-alpine AS deps
WORKDIR /app
# Copy package files from monorepo structure
COPY apps/frontend/package.json ./
COPY package-lock.json ./
RUN apk add --no-cache python3 make g++ git
# Use npm install instead of npm ci to handle monorepo dependencies
RUN npm install --legacy-peer-deps
RUN npm cache clean --force

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
# Copy frontend source from monorepo path
COPY apps/frontend/ ./
# Set environment variables for build
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV DOCKER_BUILD=true
RUN npm run build

FROM node:22-alpine AS prod
WORKDIR /app

# Copy standalone output
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

# Copy package.json for runtime
COPY --from=build /app/package.json ./

EXPOSE 3000
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
RUN chown -R nextjs:nodejs /app

USER nextjs

CMD ["node", "server.js"]
