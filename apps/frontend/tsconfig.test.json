{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest",
      "node",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests/**/*",
    "src/test/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
