{
  "name": "lokifi",
  "version": "1.0.0",
  "private": true,
  "description": "Lokifi - Full-stack financial application",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "dev:backend": "cd apps/backend && uvicorn app.main:app --reload",
    "build": "cd apps/frontend && npm run build",
    "lint": "cd apps/frontend && npm run lint",
    "lint:security": "cd apps/frontend && npm run lint:security",
    "lint:a11y": "cd apps/frontend && npm run lint:a11y",
    "lint:backend": "cd apps/backend && ruff check .",
    "typecheck": "cd apps/frontend && npm run typecheck",
    "test": "npm run test:all",
    "test:frontend": "cd apps/frontend && npm test",
    "test:backend": "cd apps/backend && pytest",
    "test:all": "npm run test:frontend && npm run test:backend",
    "test:coverage": "cd apps/frontend && npm run test:coverage",
    "clean": "npm run clean:frontend && npm run clean:backend",
    "clean:frontend": "cd apps/frontend && rm -rf .next node_modules",
    "clean:backend": "cd apps/backend && rm -rf __pycache__ .pytest_cache .ruff_cache"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ericsocrat/Lokifi.git"
  },
  "keywords": [
    "finance",
    "trading",
    "portfolio",
    "nextjs",
    "fastapi"
  ],
  "author": "Eric Socrat",
  "license": "UNLICENSED"
}
