{
  "name": "lokifi",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@lokifi/web",
    "build": "npm run build --workspace=@lokifi/web",
    "start": "npm run start --workspace=@lokifi/web",
    "typecheck": "npm run typecheck --workspace=@lokifi/web",
    "lint": "npm run lint --workspace=@lokifi/web",
    "test:e2e": "npm run test:e2e --workspace=@lokifi/web",
    "contracts": "node tools/contracts.mjs",
    "verify": "node tools/verify.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6"
  }
}
